meta {
  name: Filter Alerts By Status (OPEN)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/alerts?status=OPEN
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("All returned alerts have OPEN status", function() {
    var json = res.getBody();
    json.content.forEach(function(alert) {
      expect(alert.status).to.equal("OPEN");
    });
  });
}
