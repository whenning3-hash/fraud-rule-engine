meta {
  name: Update Alert Status → REVIEWED
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/alerts/{{alertId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "status": "REVIEWED"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Alert status updated to REVIEWED", function() {
    var json = res.getBody();
    expect(json.status).to.equal("REVIEWED");
  });
}
