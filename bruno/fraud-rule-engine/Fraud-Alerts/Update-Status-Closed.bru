meta {
  name: Update Alert Status → CLOSED
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/alerts/{{alertId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "status": "CLOSED"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Alert status updated to CLOSED", function() {
    var json = res.getBody();
    expect(json.status).to.equal("CLOSED");
  });
}
