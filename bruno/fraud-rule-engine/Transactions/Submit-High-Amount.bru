meta {
  name: Submit High Amount (Fraud Trigger - AMOUNT_THRESHOLD_RULE)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "accountId": "ACC-002",
    "amount": 15000.00,
    "currency": "ZAR",
    "merchantName": "Big Electronics Store",
    "merchantCategory": "ELECTRONICS",
    "channel": "ONLINE",
    "countryCode": "ZAF",
    "transactionTime": "2025-01-15T14:00:00"
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Risk score above zero (amount threshold breached)", function() {
    var json = res.getBody();
    expect(json.riskScore).to.be.greaterThan(0);
  });

  test("Transaction is flagged as fraudulent", function() {
    var json = res.getBody();
    expect(json.fraudulent).to.equal(true);
  });
}

vars:post {
  transactionId: res.body.id
}
