meta {
  name: Validation Error (Missing Required Fields)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "accountId": "",
    "amount": -1
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Error response is returned", function() {
    var json = res.getBody();
    expect(json).to.have.property("status");
    expect(json.status).to.equal(400);
  });
}
