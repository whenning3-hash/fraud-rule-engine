meta {
  name: Submit Country Baseline ZAF (Run BEFORE Country Mismatch)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "accountId": "ACC-007",
    "amount": 800.00,
    "currency": "ZAR",
    "merchantName": "Woolworths Cape Town",
    "merchantCategory": "RETAIL",
    "channel": "POS",
    "countryCode": "ZAF",
    "transactionTime": "2025-01-15T09:00:00"
  }
}

docs {
  ## Step 1 of 2 — Country Mismatch Scenario

  Run this request FIRST to establish South African transaction history for ACC-007.
  The COUNTRY_MISMATCH_RULE evaluates the last 24 hours and requires at least one prior
  transaction in a different country to trigger.

  After this request succeeds:
    → Run "Submit Country Mismatch" (Step 2) with accountId ACC-007 and countryCode GBR.
    → The rule detects ZAF in history vs GBR on the current transaction → impossible travel
      within the 24-hour window → riskScore +50 → FraudAlert created.

  This request alone is clean: fraudulent=false, riskScore=15 (UNUSUAL_CATEGORY only).
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Baseline transaction is clean (not fraudulent)", function() {
    var json = res.getBody();
    expect(json.fraudulent).to.equal(false);
  });
}

vars:post {
  transactionId: res.body.id
}
