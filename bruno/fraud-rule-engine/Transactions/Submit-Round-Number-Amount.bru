meta {
  name: Submit Round Number Amount (Fraud Trigger - ROUND_NUMBER_AMOUNT_RULE)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "accountId": "ACC-006",
    "amount": 10000.00,
    "currency": "ZAR",
    "merchantName": "Cash Deposit FNB",
    "merchantCategory": "BANKING",
    "channel": "BRANCH",
    "countryCode": "ZAF",
    "transactionTime": "2025-01-15T11:00:00"
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Round number amount flagged as fraudulent", function() {
    var json = res.getBody();
    // ROUND_NUMBER_AMOUNT_RULE fires: R10000 >= R5000 minimum AND 10000 % 1000 == 0
    // AMOUNT_THRESHOLD_RULE also fires: R10000 is NOT > R10000 (strict greater-than), so only ROUND fires
    // Risk weight = 25 >= threshold = 20
    expect(json.fraudulent).to.equal(true);
  });

  test("Risk score is at least 25 (ROUND_NUMBER_AMOUNT_RULE weight)", function() {
    var json = res.getBody();
    expect(json.riskScore).to.be.greaterThanOrEqualTo(25);
  });
}

vars:post {
  transactionId: res.body.id
}
