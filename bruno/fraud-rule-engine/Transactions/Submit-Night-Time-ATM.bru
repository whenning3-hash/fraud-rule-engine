meta {
  name: Submit Night-Time ATM (Fraud Trigger - NIGHT_TIME_ATM_RULE)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "accountId": "ACC-005",
    "amount": 2000.00,
    "currency": "ZAR",
    "merchantName": "ABSA ATM Sandton",
    "merchantCategory": "CASH",
    "channel": "ATM",
    "countryCode": "ZAF",
    "transactionTime": "2025-01-15T02:30:00"
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Night-time ATM withdrawal flagged as fraudulent", function() {
    var json = res.getBody();
    // NIGHT_TIME_ATM_RULE fires: hour=02 (in 00-05 window), channel=ATM, amount=R2000 >= R1500 minimum
    // Risk weight = 45 >= threshold = 20
    expect(json.fraudulent).to.equal(true);
  });

  test("Risk score is at least 45 (NIGHT_TIME_ATM_RULE weight)", function() {
    var json = res.getBody();
    expect(json.riskScore).to.be.greaterThanOrEqualTo(45);
  });
}

vars:post {
  transactionId: res.body.id
}
