meta {
  name: Submit Off-Hours Transaction (Fraud Trigger - OFF_HOURS_RULE)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "accountId": "ACC-003",
    "amount": 500.00,
    "currency": "ZAR",
    "merchantName": "ATM Sandton City",
    "merchantCategory": "ATM",
    "channel": "ATM",
    "countryCode": "ZAF",
    "transactionTime": "2025-01-15T02:30:00"
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Risk score above zero (off-hours 02:30 triggers rule)", function() {
    var json = res.getBody();
    expect(json.riskScore).to.be.greaterThan(0);
  });

  test("Transaction is flagged as fraudulent", function() {
    var json = res.getBody();
    expect(json.fraudulent).to.equal(true);
  });
}

vars:post {
  transactionId: res.body.id
}
