meta {
  name: Get Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin123"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response contains accessToken", function() {
    var json = res.getBody();
    expect(json).to.have.property("accessToken");
    expect(json.accessToken).to.be.a("string");
    expect(json.accessToken.length).to.be.greaterThan(20);
  });

  test("Token type is Bearer", function() {
    var json = res.getBody();
    expect(json.tokenType).to.equal("Bearer");
  });

  test("ExpiresIn is set", function() {
    var json = res.getBody();
    expect(json).to.have.property("expiresIn");
    expect(json.expiresIn).to.be.a("number");
  });
}

vars:post {
  bearerToken: res.body.accessToken
}
