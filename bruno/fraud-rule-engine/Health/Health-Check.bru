meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/actuator/health
  body: none
  auth: none
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Application is UP", function() {
    var json = res.getBody();
    expect(json.status).to.equal("UP");
  });
}
