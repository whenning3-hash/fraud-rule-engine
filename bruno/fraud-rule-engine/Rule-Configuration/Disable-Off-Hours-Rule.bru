meta {
  name: Disable Off-Hours Rule
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/rules/{{offHoursRuleId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "enabled": false,
    "riskWeight": 20,
    "parameters": {
      "startHour": "0",
      "endHour": "5"
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Rule is now disabled", function() {
    var json = res.getBody();
    expect(json.enabled).to.equal(false);
  });
}
