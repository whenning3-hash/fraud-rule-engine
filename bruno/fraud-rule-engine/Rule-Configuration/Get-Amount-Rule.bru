meta {
  name: Get Amount Threshold Rule
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/rules/{{amountRuleId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Rule name is AMOUNT_THRESHOLD_RULE", function() {
    var json = res.getBody();
    expect(json.ruleName).to.equal("AMOUNT_THRESHOLD_RULE");
  });

  test("maxAmount parameter present", function() {
    var json = res.getBody();
    expect(json.parameters).to.have.property("maxAmount");
  });
}
